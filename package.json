{
  "name": "entity-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Live flight monitoring dashboard on GitHub Pages, fed by an Actions-driven ADS-B data pipeline",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "collect": "tsx collector/index.ts",
    "data:local": "tsx collector/index.ts --out public",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.relay.json",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc",
    "relay:deploy": "wrangler deploy --config relay/wrangler.jsonc",
    "relay:check": "wrangler deploy --config relay/wrangler.jsonc --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
